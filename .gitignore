# node_modules: 의존성 디렉토리
node_modules/

# 빌드 출력 디렉토리
.next/
# out/

# 환경 변수 파일
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 로그 파일
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 운영 시스템 관련
.DS_Store
Thumbs.db

# VSCode 설정 (선택)
.vscode/

# TypeScript 빌드 산출물 (TS 사용하는 경우)
*.tsbuildinfo

# SASS 캐시 (SASS 사용하는 경우)
.sass-cache/

# coverage 리포트 (테스트 커버리지 도구 사용 시)
coverage/

# 기타 IDE/에디터 관련 (선택)
.idea/
*.swp
*.swo

# lint-staged 관련 임시파일
*.eslintcache

# config 파일
*.config.js